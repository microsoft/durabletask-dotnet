<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <PackageDescription>The gRPC worker for the Durable Task Framework.</PackageDescription>
    <EnableStyleCop>true</EnableStyleCop>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/Worker.csproj" />
    <ProjectReference Include="../../Abstractions/Abstractions.csproj" />
    <ProjectReference Include="../../Grpc/Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.Azure.DurableTask.Core" />
    <SharedSection Include="Core" />
    <SharedSection Include="DependencyInjection" />
    <SharedSection Include="Grpc" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AzureBlobPayloads auto-purge activities share this worker's gRPC transport, so their tests drive a
         real worker through a channel recreate. Reaching that path quickly needs the internal connect-loop
         knobs (recreate threshold), which are deliberately not part of any supported surface. -->
    <InternalsVisibleTo Include="Microsoft.DurableTask.Extensions.AzureBlobPayloads.Tests" Key="$(StrongNamePublicKey)" />
  </ItemGroup>
</Project>
